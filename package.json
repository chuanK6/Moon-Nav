{
  "name": "moon-navigation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler pages dev dist --ip 127.0.0.1 --port 8788",
    "preview": "wrangler pages dev dist --ip 127.0.0.1 --port 8788",
    "build": "tsc --noEmit && vite build && node scripts/security-headers.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file scripts/seed.sql",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "hono": "^4.13.13",
    "jose": "^6.1.0",
    "lucide-react": "^1.58.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0",
    "wrangler": "^4.0.0"
  }
}
